<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- This .NET-only graph uses versioned NuGet DCP/dashboard tools so CI needs no separately installed CLI bundle. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>2cdbd893-616c-4988-881c-15879451aa14</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Synestra.Api\Synestra.Api.csproj" />
    <ProjectReference Include="..\..\src\Synestra.MigrationWorker\Synestra.MigrationWorker.csproj" />
    <ProjectReference Include="..\..\src\Synestra.Worker\Synestra.Worker.csproj" />
  </ItemGroup>

</Project>
